<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Network for remote agents and APIs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Foreground Service for persistent orchestration -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- Keep CPU awake during task execution -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Notifications for task status -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Battery optimization exemption (user must grant) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <application
        android:name=".AgentDeckApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AgentDeck">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AgentDeck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Foreground Service for orchestration -->
        <service
            android:name=".service.OrchestrationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <!-- WorkManager initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>
        
    </application>
    
</manifest>
