{
  "name": "agent-deck-pc-bridge",
  "version": "0.1.0",
  "description": "PC-Bridge für Agent Deck Mobile – WebSocket-Server der Tasks vom Handy empfängt und lokal ausführt",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "node-pty": "^1.0.0",
    "chokidar": "^4.0.0",
    "glob": "^11.0.0",
    "toml": "^3.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.0",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
